# Optional Xbox data provider. Store the key as a production Site secret.
# Use an OpenXBL key authorized for this lookup and tied to a dedicated Xbox
# account without friends, so lookups do not reveal friends-only progress.
OPENXBL_API_KEY=

# Optional Steam Web API user key for public Halo playtime and last-played dates.
STEAM_WEB_API_KEY=

# Optional list of cross-platform account pairs verified by the site operator.
# Each entry has string keys "steam" (SteamID64) and "xbox" (Xbox XUID).
# For example: [{"steam":"76561197960265728","xbox":"2533274798129181"}]
# Removing a pair from this setting does not unlink an already merged profile.
VERIFIED_PLAYER_ACCOUNTS=

# Operator credential for the profile research API. Store as a Site secret.
# The local research command can also read it from the desktop keyring.
HALOTRACKER_PROFILE_RESEARCH_TOKEN=
